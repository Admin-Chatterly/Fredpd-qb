    { "name": "formatDate epoch ms 0", "fn": "formatDate", "input": 0, "expected": "1970-01-01" },
    { "name": "formatTime epoch ms 0", "fn": "formatTime", "input": 0, "expected": "01:00" },
    { "name": "formatTime negative epoch ms floors", "fn": "formatTime", "input": -1, "expected": "00:59" },
    { "name": "formatDate custom tokens DD/MM/YY", "fn": "formatDate", "formats": { "date": "DD/MM/YY" }, "input": "2026-09-29T10:00:00Z", "expected": "29/09/26" },
    { "name": "formatTime custom tokens HH:mm:ss", "fn": "formatTime", "formats": { "time": "HH:mm:ss" }, "input": "2026-09-29T10:15:07Z", "expected": "12:15:07" },
    { "name": "formatTime tz UTC", "fn": "formatTime", "formats": { "tz": "UTC" }, "input": "2026-07-01T10:15:00Z", "expected": "10:15" },
    { "name": "formatTime tz Europe/Helsinki summer", "fn": "formatTime", "formats": { "tz": "Europe/Helsinki" }, "input": "2026-07-01T12:00:00Z", "expected": "15:00" },
    { "name": "formatTime tz Europe/London winter", "fn": "formatTime", "formats": { "tz": "Europe/London" }, "input": "2026-01-15T12:00:00Z", "expected": "12:00" },
    { "name": "formatTime tz Europe/London summer", "fn": "formatTime", "formats": { "tz": "Europe/London" }, "input": "2026-07-01T12:00:00Z", "expected": "13:00" },
    { "name": "formatDate 30 February -> error", "fn": "formatDate", "input": "2026-02-30T00:00:00Z", "error": "invalid_value" },
    { "name": "formatTime hour 24 -> error", "fn": "formatTime", "input": "2026-09-29T24:00:00Z", "error": "invalid_value" },
    { "name": "formatDate zone on a date-only string -> error", "fn": "formatDate", "input": "2026-09-29Z", "error": "invalid_value" },
    { "name": "formatDate 1900-01-01T00:00Z is the lower bound", "fn": "formatDate", "input": "1900-01-01T00:00:00Z", "expected": "1900-01-01" },
    { "name": "formatTime 1900-01-01T00:00Z is CET", "fn": "formatTime", "input": "1900-01-01T00:00:00Z", "expected": "01:00" },
    { "name": "formatDate before 1900 -> error", "fn": "formatDate", "input": "1899-12-31T23:59:59Z", "error": "invalid_value" },
    { "name": "formatDate date-only date of birth in a pre-1996 summer", "fn": "formatDate", "input": "1975-07-01", "expected": "1975-07-01" },
    { "name": "formatDate date-only pre-1996 in Europe/London (British Standard Time 1968-71)", "fn": "formatDate", "formats": { "tz": "Europe/London" }, "input": "1970-01-01", "expected": "1970-01-01" },
    { "name": "formatDate date-only pre-1921 in Europe/Helsinki (local mean time)", "fn": "formatDate", "formats": { "tz": "Europe/Helsinki" }, "input": "1910-06-15", "expected": "1910-06-15" },
    { "name": "formatDate year 0000 -> error", "fn": "formatDate", "input": "0000-01-01T00:00:00Z", "error": "invalid_value" },
    { "name": "formatDate 9999-12-31T23:59:59Z is the upper bound", "fn": "formatDate", "formats": { "tz": "UTC" }, "input": "9999-12-31T23:59:59Z", "expected": "9999-12-31" },
    { "name": "formatDate offset past 9999 -> error", "fn": "formatDate", "input": "9999-12-31T23:59:59-01:00", "error": "invalid_value" },
    { "name": "formatTime epoch ms just below 1900 -> error", "fn": "formatTime", "input": -2208988800001, "error": "invalid_value" },
    { "name": "formatDate epoch ms beyond the JS Date range -> error", "fn": "formatDate", "input": 8640000000001000, "error": "invalid_value" },
    { "name": "formatDate epoch ms 1e300 -> error", "fn": "formatDate", "input": 1e300, "error": "invalid_value" },

    { "name": "formatCurrency 1234567 -> '1 234 567 kr'", "fn": "formatCurrency", "input": 1234567, "expected": "1 234 567 kr" },
    { "name": "formatCurrency 0 -> '0 kr'", "fn": "formatCurrency", "input": 0, "expected": "0 kr" },
    { "name": "formatCurrency negative", "fn": "formatCurrency", "input": -1500, "expected": "-1 500 kr" },
    { "name": "formatCurrency 999 has no separator", "fn": "formatCurrency", "input": 999, "expected": "999 kr" },
    { "name": "formatCurrency 1000", "fn": "formatCurrency", "input": 1000, "expected": "1 000 kr" },
    { "name": "formatCurrency rounds half away from zero", "fn": "formatCurrency", "input": 1234.5, "expected": "1 235 kr" },
    { "name": "formatCurrency negative half rounds away from zero", "fn": "formatCurrency", "input": -2.5, "expected": "-3 kr" },
    { "name": "formatCurrency tiny negative rounds to unsigned zero", "fn": "formatCurrency", "input": -0.4, "expected": "0 kr" },
    { "name": "formatCurrency prefix symbol with decimals", "fn": "formatCurrency", "formats": { "currency": { "symbol": "€", "decimals": 2, "thousandsSeparator": ".", "decimalSeparator": ",", "position": "prefix" } }, "input": 1234567.891, "expected": "€1.234.567,89" },
    { "name": "formatCurrency decimalSeparator defaults to comma", "fn": "formatCurrency", "formats": { "currency": { "symbol": "kr", "decimals": 2, "thousandsSeparator": " ", "position": "suffix" } }, "input": 1234.5, "expected": "1 234,50 kr" },
    { "name": "formatCurrency empty symbol", "fn": "formatCurrency", "formats": { "currency": { "symbol": "", "decimals": 0, "thousandsSeparator": " ", "position": "suffix" } }, "input": 5000, "expected": "5 000" },
    { "name": "formatCurrency 10^15", "fn": "formatCurrency", "input": 1000000000000000, "expected": "1 000 000 000 000 000 kr" },
    { "name": "formatCurrency 2^53 -> error", "fn": "formatCurrency", "input": 9007199254740992, "error": "invalid_value" },
    { "name": "formatCurrency large integer with decimals overflows -> error", "fn": "formatCurrency", "formats": { "currency": { "symbol": "kr", "decimals": 2, "thousandsSeparator": " ", "position": "suffix" } }, "input": 100000000000000000, "error": "invalid_value" },
    { "name": "formatCurrency separator with $ is inserted literally", "fn": "formatCurrency", "formats": { "currency": { "symbol": "kr", "decimals": 0, "thousandsSeparator": "$&", "position": "suffix" } }, "input": 1234567, "expected": "1$&234$&567 kr" },

    { "name": "load base formats", "fn": "load" },
    { "name": "load unknown placeholder in a template -> error", "fn": "load", "formats": { "evidenceTag": "B-{{case}}-{{x}}" }, "error": "invalid_config" },
    { "name": "load group in plate pattern -> error", "fn": "load", "formats": { "plate": "^(ABC)\\d+$" }, "error": "invalid_config" },
    { "name": "load unsupported time zone -> error", "fn": "load", "formats": { "tz": "America/New_York" }, "error": "invalid_config" },
    { "name": "load caseNumber containing {{case}} -> error", "fn": "load", "formats": { "caseNumber": "{{case}}-1" }, "error": "invalid_config" },
    { "name": "load wrong type -> error", "fn": "load", "formats": { "personId": 5 }, "error": "invalid_config" },
    { "name": "load bad currency position -> error", "fn": "load", "formats": { "currency": { "symbol": "kr", "decimals": 0, "thousandsSeparator": " ", "position": "middle" } }, "error": "invalid_config" }
  ],
  "regex": [
    { "pattern": "^[A-Z]{3}\\s?\\d{2}[A-Z0-9]$", "yes": ["ABC 12D", "ABC123", "XYZ\t99A"], "no": ["AB 12D", "ABC  12D", "abc123", "ABC123X", " ABC123"] },
    { "pattern": "^\\d{6,8}-?\\d{4}$", "yes": ["900101-1234", "19900101-1234", "9001011234", "199001011234"], "no": ["90010-1234", "900101--1234", "900101-123", "1990010112345", "900101-1234a"] },
    { "pattern": "\\d{3}", "yes": ["ab123c", "123"], "no": ["12a3", ""] },
    { "pattern": "^a.c$", "yes": ["abc", "a-c", "a c"], "no": ["a\nc", "a\rc", "ac", "abbc"] },
    { "pattern": "^[^0-9]+$", "yes": ["abc", "-_"], "no": ["ab1", ""] },
    { "pattern": "^x{2,3}$", "yes": ["xx", "xxx"], "no": ["x", "xxxx", ""] },
    { "pattern": "^x{2,}$", "yes": ["xx", "xxxxxxxx"], "no": ["x"] },
    { "pattern": "^x{2}y?$", "yes": ["xx", "xxy"], "no": ["xxx", "xy"] },
    { "pattern": "^\\w+@\\w+\\.se$", "yes": ["anna_b@polis.se"], "no": ["anna@polis.com", "anna@polis-se", "@polis.se"] },
    { "pattern": "^[a-c-]+$", "yes": ["abc-", "-"], "no": ["abd"] },
    { "pattern": "^[\\d-z]+$", "yes": ["1-z", "z9"], "no": ["y", "a"] },
    { "pattern": "^\\W\\S\\D$", "yes": ["-ab", "!x!", " ab"], "no": ["a b", "--1", "-  "] },
    { "pattern": "^$", "yes": [""], "no": ["a"] },
    { "pattern": "^a*b?c+$", "yes": ["c", "abc", "aaacc", "bc"], "no": ["ab", "abbc", ""] },
    { "pattern": "x$", "yes": ["abx"], "no": ["xa"] },
    { "pattern": "^[\\]\\\\]+$", "yes": ["]\\"], "no": ["a"] },
    { "pattern": "a]b}", "yes": ["za]b}"], "no": ["ab"] },
    { "pattern": "^[]a$", "yes": [], "no": ["a", "]a"] },
    { "pattern": "^[^]$", "yes": ["a", "\n"], "no": ["", "ab"] },
    { "pattern": "^\\t\\.\\/\\-$", "yes": ["\t./-"], "no": ["\tx/-"] },
    { "pattern": "^[\\t-\\r ]+$", "yes": [" \t\n"], "no": ["a"] },
