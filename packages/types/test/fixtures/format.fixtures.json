{
  "$comment": "Shared fixtures for packages/types/src/format.ts and fredpd_core/shared/format.lua (docs/contracts.md §C4). Run by packages/types/test/format.test.ts and tests/lua/format_test.lua. `formats` is the base config (a copy of the §9 defaults so the suite does not depend on edits to config/formats.json); a case's own `formats` is shallow-merged over it. A case has either `expected` or `error` (a FormatError code). `regex` cross-checks the Lua engine against native JS RegExp.",
  "formats": {
    "callsign": "{{unit}}-{{n:2}}",
    "caseNumber": "K-{{seq}}-{{yy}}",
    "reportNumber": "{{case}}/{{n}}",
    "evidenceTag": "B-{{case}}-{{n:3}}",
    "plate": "^[A-Z]{3}\\s?\\d{2}[A-Z0-9]$",
    "personId": "^\\d{6,8}-?\\d{4}$",
    "date": "YYYY-MM-DD",
    "time": "HH:mm",
    "tz": "Europe/Stockholm",
    "currency": { "symbol": "kr", "decimals": 0, "thousandsSeparator": " ", "position": "suffix" }
  },
  "cases": [
    { "name": "formatId callsign IGV-07", "fn": "formatId", "format": "callsign", "ctx": { "unit": "IGV", "n": 7 }, "expected": "IGV-07" },
    { "name": "formatId callsign counter wider than the pad", "fn": "formatId", "format": "callsign", "ctx": { "unit": "SPAN", "n": 123 }, "expected": "SPAN-123" },
    { "name": "formatId caseNumber K-123-26", "fn": "formatId", "format": "caseNumber", "ctx": { "seq": 123, "date": "2026-05-01T10:00:00Z" }, "expected": "K-123-26" },
    { "name": "formatId caseNumber takes the Stockholm year (23:30Z on 31 Dec is already next year)", "fn": "formatId", "format": "caseNumber", "ctx": { "seq": 1, "date": "2026-12-31T23:30:00Z" }, "expected": "K-1-27" },
    { "name": "formatId caseNumber 22:59:59Z on 31 Dec is still this year", "fn": "formatId", "format": "caseNumber", "ctx": { "seq": 5, "date": "2026-12-31T22:59:59Z" }, "expected": "K-5-26" },
    { "name": "formatId caseNumber with date as epoch ms (2026-12-31T23:00Z)", "fn": "formatId", "format": "caseNumber", "ctx": { "seq": 9, "date": 1798758000000 }, "expected": "K-9-27" },
    { "name": "formatId caseNumber with seq as a digit string", "fn": "formatId", "format": "caseNumber", "ctx": { "seq": "77", "date": "2026-09-29" }, "expected": "K-77-26" },
    { "name": "formatId reportNumber K-123-26/2", "fn": "formatId", "format": "reportNumber", "ctx": { "case": "K-123-26", "n": 2 }, "expected": "K-123-26/2" },
    { "name": "formatId evidenceTag B-K-123-26-004", "fn": "formatId", "format": "evidenceTag", "ctx": { "case": "K-123-26", "n": 4 }, "expected": "B-K-123-26-004" },
    { "name": "formatId yyyy placeholder", "fn": "formatId", "template": "D-{{yyyy}}-{{seq}}", "ctx": { "seq": 42, "date": "2026-09-29T12:00:00Z" }, "expected": "D-2026-42" },
    { "name": "formatId n:3 pads zero", "fn": "formatId", "template": "{{n:3}}", "ctx": { "n": 0 }, "expected": "000" },
    { "name": "formatId literal-only template", "fn": "formatId", "template": "ABC", "ctx": {}, "expected": "ABC" },
    { "name": "formatId missing seq -> error", "fn": "formatId", "format": "caseNumber", "ctx": { "date": "2026-05-01T10:00:00Z" }, "error": "missing_value" },
    { "name": "formatId missing date for yy -> error", "fn": "formatId", "format": "caseNumber", "ctx": { "seq": 1 }, "error": "missing_value" },
    { "name": "formatId missing unit -> error", "fn": "formatId", "format": "callsign", "ctx": { "n": 7 }, "error": "missing_value" },
    { "name": "formatId missing case -> error", "fn": "formatId", "format": "evidenceTag", "ctx": { "n": 1 }, "error": "missing_value" },
    { "name": "formatId unknown placeholder -> error", "fn": "formatId", "template": "X-{{foo}}", "ctx": { "seq": 1 }, "error": "unknown_placeholder" },
    { "name": "formatId width on a non-counter placeholder -> error", "fn": "formatId", "template": "{{yy:4}}", "ctx": { "date": "2026-01-01" }, "error": "unknown_placeholder" },
    { "name": "formatId placeholder with spaces -> error", "fn": "formatId", "template": "{{ seq }}", "ctx": { "seq": 1 }, "error": "unknown_placeholder" },
    { "name": "formatId unclosed placeholder -> error", "fn": "formatId", "template": "K-{{seq", "ctx": { "seq": 1 }, "error": "invalid_template" },
    { "name": "formatId width 0 -> error", "fn": "formatId", "template": "{{n:0}}", "ctx": { "n": 1 }, "error": "invalid_template" },
    { "name": "formatId negative counter -> error", "fn": "formatId", "format": "callsign", "ctx": { "unit": "IGV", "n": -1 }, "error": "invalid_value" },
    { "name": "formatId fractional counter -> error", "fn": "formatId", "format": "callsign", "ctx": { "unit": "IGV", "n": 2.5 }, "error": "invalid_value" },
    { "name": "formatId lower-case unit code -> error", "fn": "formatId", "format": "callsign", "ctx": { "unit": "igv", "n": 7 }, "error": "invalid_value" },
    { "name": "formatId unparseable date -> error", "fn": "formatId", "format": "caseNumber", "ctx": { "seq": 1, "date": "yesterday" }, "error": "invalid_value" },
    { "name": "formatId ctx that is a number -> error", "fn": "formatId", "format": "callsign", "ctx": 5, "error": "invalid_value" },
    { "name": "formatId ctx that is a boolean -> error, even without placeholders", "fn": "formatId", "template": "ABC", "ctx": true, "error": "invalid_value" },
    { "name": "formatId ctx that is a string -> error", "fn": "formatId", "format": "callsign", "ctx": "IGV", "error": "invalid_value" },

    { "name": "templateToRegex caseNumber", "fn": "templateToRegex", "format": "caseNumber", "expected": "^K-\\d+-\\d{2}$", "matches": ["K-123-26", "K-1-99"], "rejects": ["K-123-2026", "k-123-26", "K--26", "XK-1-26", "K-123-26/2"] },
    { "name": "templateToRegex reportNumber embeds the caseNumber pattern", "fn": "templateToRegex", "format": "reportNumber", "expected": "^K-\\d+-\\d{2}/\\d+$", "matches": ["K-123-26/2", "K-1-26/10"], "rejects": ["K-123-26/", "K-123-26"] },
    { "name": "templateToRegex evidenceTag", "fn": "templateToRegex", "format": "evidenceTag", "expected": "^B-K-\\d+-\\d{2}-\\d{3,}$", "matches": ["B-K-123-26-004", "B-K-1-26-1234"], "rejects": ["B-K-123-26-04", "B-K-123-26"] },
    { "name": "templateToRegex callsign", "fn": "templateToRegex", "format": "callsign", "expected": "^[A-Z]+-\\d{2,}$", "matches": ["IGV-07", "SPAN-123"], "rejects": ["IGV-7", "igv-07", "IGV07"] },
    { "name": "templateToRegex escapes regex metacharacters in literals", "fn": "templateToRegex", "format": "caseNumber", "formats": { "caseNumber": "K.{{seq}}+({{yyyy}})" }, "expected": "^K\\.\\d+\\+\\(\\d{4}\\)$", "matches": ["K.12+(2026)"], "rejects": ["KX12+(2026)", "K.12+2026"] },
    { "name": "templateToRegex unknown format name -> error", "fn": "templateToRegex", "format": "poiNumber", "error": "invalid_value" },
    { "name": "templateToRegex Object.prototype member name -> error", "fn": "templateToRegex", "format": "toString", "error": "invalid_value" },
    { "name": "templateToRegex __proto__ -> error", "fn": "templateToRegex", "format": "__proto__", "error": "invalid_value" },

    { "name": "detectSearchType 'abc 12d' -> plate ABC12D", "fn": "detectSearchType", "query": "abc 12d", "expected": { "type": "plate", "normalized": "ABC12D" } },
    { "name": "detectSearchType 'ABC123' -> plate", "fn": "detectSearchType", "query": "ABC123", "expected": { "type": "plate", "normalized": "ABC123" } },
    { "name": "detectSearchType trims before matching a plate", "fn": "detectSearchType", "query": "  xyz 99a  ", "expected": { "type": "plate", "normalized": "XYZ99A" } },
    { "name": "detectSearchType '19900101-1234' -> personId", "fn": "detectSearchType", "query": "19900101-1234", "expected": { "type": "personId", "normalized": "19900101-1234" } },
    { "name": "detectSearchType '9001011234' -> personId with dash", "fn": "detectSearchType", "query": "9001011234", "expected": { "type": "personId", "normalized": "900101-1234" } },
    { "name": "detectSearchType 12-digit personId gets a dash", "fn": "detectSearchType", "query": "199001011234", "expected": { "type": "personId", "normalized": "19900101-1234" } },
    { "name": "detectSearchType '900101-1234' -> personId unchanged", "fn": "detectSearchType", "query": "900101-1234", "expected": { "type": "personId", "normalized": "900101-1234" } },
    { "name": "detectSearchType 'K-123-26' -> caseNumber", "fn": "detectSearchType", "query": "K-123-26", "expected": { "type": "caseNumber", "normalized": "K-123-26" } },
    { "name": "detectSearchType lower-case case number is upper-cased", "fn": "detectSearchType", "query": " k-123-26 ", "expected": { "type": "caseNumber", "normalized": "K-123-26" } },
    { "name": "detectSearchType 'Anna Berg' -> name", "fn": "detectSearchType", "query": "Anna Berg", "expected": { "type": "name", "normalized": "Anna Berg" } },
    { "name": "detectSearchType name whitespace is trimmed and collapsed", "fn": "detectSearchType", "query": "  Anna \t  Berg ", "expected": { "type": "name", "normalized": "Anna Berg" } },
    { "name": "detectSearchType non-ASCII name passes through", "fn": "detectSearchType", "query": "Åsa Öberg", "expected": { "type": "name", "normalized": "Åsa Öberg" } },
    { "name": "detectSearchType incomplete plate -> name", "fn": "detectSearchType", "query": "ABC 12", "expected": { "type": "name", "normalized": "ABC 12" } },
    { "name": "detectSearchType report number is not a case number", "fn": "detectSearchType", "query": "K-123-26/2", "expected": { "type": "name", "normalized": "K-123-26/2" } },
    { "name": "detectSearchType empty query -> empty name", "fn": "detectSearchType", "query": "   ", "expected": { "type": "name", "normalized": "" } },
    { "name": "detectSearchType uses the configured plate pattern (GTA default)", "fn": "detectSearchType", "formats": { "plate": "^[A-Z0-9]{2,8}$" }, "query": "fredpd1", "expected": { "type": "plate", "normalized": "FREDPD1" } },
    { "name": "detectSearchType NBSP inside a plate is folded to a space", "fn": "detectSearchType", "query": "ABC\u00a012D", "expected": { "type": "plate", "normalized": "ABC12D" } },
    { "name": "detectSearchType ideographic space inside a plate is folded", "fn": "detectSearchType", "query": "abc\u3000123", "expected": { "type": "plate", "normalized": "ABC123" } },
    { "name": "detectSearchType Unicode spaces in a name are trimmed and collapsed", "fn": "detectSearchType", "query": "\ufeffAnna\u2003\u00a0Berg\u00a0", "expected": { "type": "name", "normalized": "Anna Berg" } },
    { "name": "detectSearchType Unicode spaces around a personId are trimmed", "fn": "detectSearchType", "query": "\u202f9001011234\u2028", "expected": { "type": "personId", "normalized": "900101-1234" } },

    { "name": "formatDate DST start 2026-03-29T00:59Z is still CET", "fn": "formatDate", "input": "2026-03-29T00:59:00Z", "expected": "2026-03-29" },
    { "name": "formatTime DST start 2026-03-29T00:59Z is still CET", "fn": "formatTime", "input": "2026-03-29T00:59:00Z", "expected": "01:59" },
    { "name": "formatTime DST start 2026-03-29T01:00Z is CEST", "fn": "formatTime", "input": "2026-03-29T01:00:00Z", "expected": "03:00" },
    { "name": "formatTime DST end 2026-10-25T00:59Z is still CEST", "fn": "formatTime", "input": "2026-10-25T00:59:00Z", "expected": "02:59" },
    { "name": "formatTime DST end 2026-10-25T01:00Z is CET", "fn": "formatTime", "input": "2026-10-25T01:00:00Z", "expected": "02:00" },
    { "name": "formatDate DST end 2026-10-25T01:00Z", "fn": "formatDate", "input": "2026-10-25T01:00:00Z", "expected": "2026-10-25" },
    { "name": "formatTime DST start 2027-03-28T00:59Z is still CET", "fn": "formatTime", "input": "2027-03-28T00:59:00Z", "expected": "01:59" },
    { "name": "formatTime DST start 2027-03-28T01:00Z is CEST", "fn": "formatTime", "input": "2027-03-28T01:00:00Z", "expected": "03:00" },
    { "name": "formatDate rolls over at local midnight in summer", "fn": "formatDate", "input": "2026-06-30T22:30:00Z", "expected": "2026-07-01" },
    { "name": "formatTime just after local midnight in summer", "fn": "formatTime", "input": "2026-06-30T22:30:00Z", "expected": "00:30" },
    { "name": "formatTime winter is UTC+1", "fn": "formatTime", "input": "2026-01-15T12:00:00Z", "expected": "13:00" },
    { "name": "formatTime explicit +02:00 offset", "fn": "formatTime", "input": "2026-07-01T12:00:00+02:00", "expected": "12:00" },
    { "name": "formatTime offset without colon", "fn": "formatTime", "input": "2026-07-01T12:00:00-0130", "expected": "15:30" },
    { "name": "formatTime no offset is treated as UTC", "fn": "formatTime", "input": "2026-09-29T10:15:00", "expected": "12:15" },
    { "name": "formatTime fractional seconds are ignored", "fn": "formatTime", "input": "2026-09-29T10:15:59.999Z", "expected": "12:15" },
    { "name": "formatDate date-only input", "fn": "formatDate", "input": "2026-09-29", "expected": "2026-09-29" },
