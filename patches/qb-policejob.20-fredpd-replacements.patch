+
+-- FredPD (patches/qb-policejob.20-fredpd-replacements.patch): the built-in evidence above is off only while
+-- fredpd_core reports the evidence feature (exports.fredpd_core:hasFeature('evidence'): noobsystems/evidences and
+-- fredpd_forensics run, which needs ox_inventory + ox_target). On a qb-inventory server it stays on. Clients ask once
+-- at start and are told again when one of the resources that decide it starts or stops (client/evidence.lua).
+local evidenceOff = nil
+
+QBCore.Functions.CreateCallback('police:server:fredpdEvidence', function(_, cb)
+    evidenceOff = FredPD.evidenceReplaced()
+    cb(not evidenceOff)
+end)
+
+local function evidenceChanged(resource)
+    if resource ~= 'fredpd_core' and resource ~= 'fredpd_forensics' and resource ~= 'evidences' then return end
+    local off = FredPD.evidenceReplaced()
+    if off == evidenceOff then return end
+    evidenceOff = off
+    TriggerClientEvent('police:client:fredpdEvidence', -1, not off)
+end
+
+AddEventHandler('onServerResourceStart', evidenceChanged)
+AddEventHandler('onServerResourceStop', evidenceChanged)
