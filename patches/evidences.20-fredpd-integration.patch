diff --git a/client/dui/laptops/target.lua b/client/dui/laptops/target.lua
index ec11873..1cc9bab 100644
--- a/client/dui/laptops/target.lua
+++ b/client/dui/laptops/target.lua
@@ -6,6 +6,26 @@ local focus <const> = require "client.dui.focus"
 
 local lastTargetCoords = nil
 
+-- FredPD patch: lets another resource open the laptop UI on a laptop entity (fredpd_forensics: "Analysera" in the
+-- station lab). Same logout rule as the "interact" option below when the player switches to another laptop.
+exports("openLaptop", function(entity)
+    if type(entity) ~= "number" or not DoesEntityExist(entity) or GetEntityModel(entity) ~= `p_laptop_02_s` then
+        return false
+    end
+
+    local coords <const> = GetEntityCoords(entity)
+    if coords ~= lastTargetCoords then
+        dui:sendMessage({
+            action = "switchScreen",
+            screen = "screensaver"
+        })
+        lastTargetCoords = coords
+    end
+
+    focus.start(entity)
+    return true
+end)
+
 exports.ox_target:addModel(`p_laptop_02_s`, {
     -- Everyone can interact with any laptop entity
     {
