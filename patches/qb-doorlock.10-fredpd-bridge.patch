+
+-- FredPD bridge exports (patches/qb-doorlock.10-fredpd-bridge.patch, docs/modules/bridge.md). Server-to-server only:
+-- no authorisation is checked here, the calling resource has done it (like ox_doorlock's setDoorState export).
+local function doorCoords(door)
+	if door.objCoords then return door.objCoords end
+	if door.doors and door.doors[1] and door.doors[1].objCoords then return door.doors[1].objCoords end
+	return door.textCoords
+end
+
+exports('getDoor', function(doorID)
+	local door = doorID ~= nil and Config.DoorList[doorID]
+	if not door then return nil end
+	return { id = doorID, name = door.doorLabel, locked = door.locked == true, coords = doorCoords(door) }
+end)
+
+exports('setDoorState', function(doorID, locked, playerId)
+	if (type(doorID) ~= 'number' and type(doorID) ~= 'string') or type(locked) ~= 'boolean' then return false end
+	if not Config.DoorList[doorID] then return false end
+	applyDoorState(doorID, locked, tonumber(playerId) or 0, false, Config.EnableSounds, false)
+	return true
+end)
