diff --git a/fredpd/client.lua b/fredpd/client.lua
new file mode 100644
index 0000000..fde05cb
--- /dev/null
+++ b/fredpd/client.lua
@@ -0,0 +1,128 @@
+-- SPDX-License-Identifier: GPL-3.0-only
+-- FredPD armory for qb-policejob (client), added by FredPD's patches/qb-policejob.10-grants.patch.
+-- The server decides everything (fredpd/server.lua): this file only adds the armory zones it is given and shows the
+-- item list the server already filtered by the officer's grants; taking an item is checked again server-side.
+-- No loops: zones are added at start and again when the server says fredpd_core started or stopped. With
+-- Config.UseTarget a qb-target zone, otherwise a PolyZone box that shows a qb-menu header while inside (the same
+-- pattern as the upstream garage, client/job.lua:1002-1037).
+
+local zones = {}
+
+local ERRORS = {
+    off_duty = 'error.on_duty_police_only',
+    no_grant = 'fredpd.no_permission',
+    too_far = 'fredpd.armory_too_far',
+    full = 'fredpd.armory_full',
+    limit = 'fredpd.armory_limit',
+    rate_limited = 'fredpd.try_again',
+    unavailable = 'fredpd.armory_unavailable',
+    failed = 'fredpd.armory_failed',
+}
+
+local function notifyError(err)
+    QBCore.Functions.Notify(Lang:t(ERRORS[err] or 'fredpd.armory_failed'), 'error')
+end
+
+local function onDutyLeo()
+    return PlayerJob ~= nil and PlayerJob.type == 'leo' and PlayerJob.onduty == true
+end
+
+local function openArmory(armoryId)
+    QBCore.Functions.TriggerCallback('police:server:fredpdArmory', function(data, err)
+        if not data then return notifyError(err) end
+        if #data.items == 0 then
+            return QBCore.Functions.Notify(Lang:t('fredpd.armory_empty'), 'primary')
+        end
+        local menu = { { header = Lang:t('fredpd.armory_title', { armory = data.label }), isMenuHeader = true } }
+        for _, item in ipairs(data.items) do
+            menu[#menu + 1] = {
+                header = item.label,
+                txt = Lang:t('fredpd.armory_count', { count = item.count }),
+                params = { event = 'police:client:fredpdArmoryTake', args = { id = armoryId, item = item } },
+            }
+        end
+        menu[#menu + 1] = { header = Lang:t('menu.close'), txt = '', params = { event = 'qb-menu:client:closeMenu' } }
+        exports['qb-menu']:openMenu(menu)
+    end, armoryId)
+end
+
+RegisterNetEvent('police:client:fredpdArmory', function(data)
+    if type(data) == 'table' and type(data.id) == 'string' then openArmory(data.id) end
+end)
+
+RegisterNetEvent('police:client:fredpdArmoryTake', function(data)
+    if type(data) ~= 'table' or type(data.item) ~= 'table' then return end
+    QBCore.Functions.TriggerCallback('police:server:fredpdArmoryTake', function(ok, err)
+        if ok then
+            QBCore.Functions.Notify(Lang:t('fredpd.armory_taken', { count = data.item.count, item = data.item.label }),
+                'success')
+        else
+            notifyError(err)
+        end
+    end, data.id, data.item.name)
+end)
+
+local function clearZones()
+    for i = 1, #zones do
+        local zone = zones[i]
+        pcall(function()
+            if type(zone) == 'string' then exports['qb-target']:RemoveZone(zone) else zone:destroy() end
+        end)
+    end
+    zones = {}
+end
+
+local function addZone(point)
+    local name = 'fredpd_armory_' .. point.id
+    local center = vector3(point.coords.x, point.coords.y, point.coords.z)
+    local radius = tonumber(point.radius) or 1.5
+    if Config.UseTarget then
+        local ok = pcall(function()
+            exports['qb-target']:AddCircleZone(name, center, radius, { name = name, useZ = true, debugPoly = false }, {
+                options = { {
+                    type = 'client',
+                    event = 'police:client:fredpdArmory',
+                    id = point.id,
+                    icon = 'fas fa-gun',
+                    label = Lang:t('target.open_armory'),
+                    jobType = 'leo',
+                    canInteract = onDutyLeo,
+                } },
+                distance = 1.5,
+            })
+        end)
+        if ok then zones[#zones + 1] = name end
+        return
+    end
+    local ok, zone = pcall(function()
+        return BoxZone:Create(center, radius * 2, radius * 2, {
+            name = name, debugPoly = false, minZ = center.z - 1, maxZ = center.z + 1,
+        })
+    end)
+    if not ok or not zone then return end
+    zone:onPlayerInOut(function(isPointInside)
+        if isPointInside and onDutyLeo() then
+            exports['qb-menu']:showHeader({ {
+                header = Lang:t('menu.pol_armory'),
+                params = { event = 'police:client:fredpdArmory', args = { id = point.id } },
+            } })
+        elseif not isPointInside then
+            exports['qb-menu']:closeMenu()
+        end
+    end)
+    zones[#zones + 1] = zone
+end
+
+local function loadZones()
+    QBCore.Functions.TriggerCallback('police:server:fredpdArmories', function(points)
+        clearZones()
+        for _, point in ipairs(points or {}) do addZone(point) end
+    end)
+end
+
+-- qb-target passes the option table as the event argument (its `id` field names the armory).
+RegisterNetEvent('police:client:fredpdArmories', loadZones)
+
+AddEventHandler('onClientResourceStart', function(resource)
+    if resource == GetCurrentResourceName() or resource == 'qb-target' then loadZones() end
+end)
diff --git a/fredpd/server.lua b/fredpd/server.lua
new file mode 100644
index 0000000..0e96b03
--- /dev/null
+++ b/fredpd/server.lua
@@ -0,0 +1,739 @@
+-- SPDX-License-Identifier: GPL-3.0-only
+-- FredPD bridge for qb-policejob, added by FredPD's patches/qb-policejob.10-grants.patch (docs/modules/police-qb.md in
+-- the FredPD repository). Listed in fxmanifest.lua right after server/main.lua; sets the global `FredPD`.
+--
+-- While fredpd_core is started, duty and permissions come from FredPD (exports.fredpd_core:isOnDuty / hasGrant,
+-- grants from Discord roles) instead of the qb-core job grade, and the police garage and armory only offer granted
+-- vehicles and items (re-checked by the server when they are handed out). While fredpd_core is not started, `check`
+-- answers nil and every caller applies qb-policejob's own upstream check, so the patch never bricks the job.
+-- Plain Lua 5.4 (no cfxlua syntax); unit-tested by tests/lua/qbpolice_*_test.lua in the FredPD repository.
+
+local M = {}
+
+M.CORE = 'fredpd_core'
+M.CONFIG_FILE = 'config/police.json'
+M.CONFIG_SECTION = 'qbPolicejob'
+M.INVENTORY = 'qb-inventory'
+
+--- Grant types of docs/contracts.md C2.
+M.GRANT_TYPES = {
+    weapon = true, vehicle = true, armory = true, tool = true, mdt_page = true, intel_tier = true, unit = true,
+    perm = true,
+}
+
+--- Built-in configuration. FredPD's config/police.json (copied to fredpd_core/config/) overrides it: the shared
+--- `actions` and `radar`, then its `qbPolicejob` section (`actions` on top of the shared ones, garage, armories,
+--- qbShops, maxFine). actions: qb-policejob action -> 'type:key' grant, or 'duty' (on duty is enough). An action
+--- without a valid entry is refused (fail closed) while fredpd_core runs.
+M.DEFAULTS = {
+    actions = {
+        anklet = 'duty',
+        bill = 'perm:charges.fine',
+        camera = 'duty',
+        cuff = 'duty',
+        evidence = 'duty',
+        fine = 'perm:charges.fine',
+        flagplate = 'perm:bolo.create',
+        impound = 'perm:police.impound',
+        jail = 'perm:police.jail',
+        license = 'perm:police.license',
+        object = 'duty',
+        paylawyer = 'duty',
+        paytow = 'duty',
+        plateinfo = 'duty',
+        search = 'duty',
+        seizecash = 'duty',
+        seizelicense = 'duty',
+        spikestrip = 'duty',
+        tracker = 'duty',
+        unflagplate = 'perm:bolo.resolve',
+    },
+    garage = { vehicles = {}, maxDistance = 15 },
+    armories = {
+        mrpd = {
+            label = 'Mission Row',
+            coords = { 462.23, -981.12, 30.68 },
+            radius = 1.5,
+            -- qb-core shared/items.lua names; max: no take while the officer already carries that many
+            -- (qb-inventory GetItemCount); nil = no limit
+            items = {
+                { name = 'weapon_pistol', count = 1, max = 1 },
+                { name = 'weapon_stungun', count = 1, max = 1 },
+                { name = 'weapon_nightstick', count = 1, max = 1 },
+                { name = 'weapon_flashlight', count = 1, max = 1 },
+                { name = 'weapon_carbinerifle', count = 1, max = 1 },
+                { name = 'pistol_ammo', count = 2, max = 6 },
+                { name = 'rifle_ammo', count = 2, max = 6 },
+                { name = 'handcuffs', count = 1, max = 2 },
+            },
+        },
+    },
+    qbShops = {},
+    maxFine = 100000,
+    radar = { cooldownSeconds = 60, maxDistance = 50 },
+}
+
+local GRANT_KEY = '^[A-Za-z0-9_%.:%*%-]+$'
+local ARMORY_ID = '^[%w_%-]+$'
+
+---------------------------------------------------------------------------------------------------------------
+-- Small helpers
+
+local warned = {}
+
+--- One console warning per distinct message (no log spam from a hot path).
+function M.warnOnce(fmt, ...)
+    local msg = fmt:format(...)
+    if warned[msg] then return end
+    warned[msg] = true
+    print('^3[qb-policejob] ' .. msg .. '^0')
+end
+local warnOnce = M.warnOnce
+
+local function copy(value)
+    if type(value) ~= 'table' then return value end
+    local out = {}
+    for k, v in pairs(value) do out[k] = copy(v) end
+    return out
+end
+M.copy = copy
+
+local function isComment(key)
+    return type(key) == 'string' and key:sub(1, 1) == '$'
+end
+
+--- Parse 'type:key' into type, key (nil when malformed or an unknown type).
+function M.parseGrant(spec)
+    if type(spec) ~= 'string' then return nil end
+    local grantType, key = spec:match('^([%w_]+):(.+)$')
+    if not grantType or not M.GRANT_TYPES[grantType] or #key > 64 or not key:find(GRANT_KEY) then return nil end
+    return grantType, key
+end
+
+--- Plate as FredPD stores it (docs/contracts.md C4): upper case, no whitespace; nil when unusable.
+function M.normalizePlate(plate)
+    if type(plate) ~= 'string' then return nil end
+    local normalized = plate:upper():gsub('%s+', '')
+    if normalized == '' or #normalized > 16 or not normalized:find('^[%w%-]+$') then return nil end
+    return normalized
+end
+
+--- x, y, z of a vector3/vector4, a { x, y, z } table or a { [1], [2], [3] } array (nil when not all numbers).
+function M.xyz(v)
+    local tv = type(v)
+    if tv ~= 'table' and tv ~= 'userdata' and tv ~= 'vector3' and tv ~= 'vector4' then return nil end
+    local ok, x, y, z = pcall(function() return v.x or v[1], v.y or v[2], v.z or v[3] end)
+    if ok and type(x) == 'number' and type(y) == 'number' and type(z) == 'number'
+        and x == x and y == y and z == z then
+        return x, y, z
+    end
+    return nil
+end
+
+function M.distance(a, b)
+    local ax, ay, az = M.xyz(a)
+    local bx, by, bz = M.xyz(b)
+    if not ax or not bx then return math.huge end
+    return math.sqrt((ax - bx) ^ 2 + (ay - by) ^ 2 + (az - bz) ^ 2)
+end
+
+--- Metres between a player and a point (math.huge when unknown).
+function M.playerDistance(src, point)
+    local ped = GetPlayerPed(src)
+    if not ped or ped == 0 then return math.huge end
+    return M.distance(GetEntityCoords(ped), point)
+end
+
+--- A whole number (integer-valued float accepted) or nil.
+function M.int(value)
+    return math.tointeger(tonumber(value))
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- Configuration
+
+local function mergeActions(cfg, actions)
+    if type(actions) ~= 'table' then return end
+    for action, spec in pairs(actions) do
+        if type(action) == 'string' and not isComment(action) then
+            if spec == 'duty' or M.parseGrant(spec) then
+                cfg.actions[action] = spec
+            else
+                warnOnce('config/police.json: action "%s" has an invalid grant %s; the action is refused',
+                    action, tostring(spec))
+                cfg.actions[action] = nil
+            end
+        end
+    end
+end
+
+--- Merge a decoded config/police.json over the defaults. Unknown or malformed entries are warned about and dropped.
+function M.buildConfig(decoded)
+    local cfg = copy(M.DEFAULTS)
+    if type(decoded) ~= 'table' then return cfg end
+    mergeActions(cfg, decoded.actions)
+    if type(decoded.radar) == 'table' then
+        for _, key in ipairs({ 'cooldownSeconds', 'maxDistance' }) do
+            local v = decoded.radar[key]
+            if type(v) == 'number' and v >= 0 then cfg.radar[key] = v end
+        end
+    end
+    local qb = decoded[M.CONFIG_SECTION]
+    if type(qb) ~= 'table' then return cfg end
+    mergeActions(cfg, qb.actions)
+    if type(qb.garage) == 'table' then
+        local g = qb.garage
+        if type(g.vehicles) == 'table' then
+            cfg.garage.vehicles = {}
+            for model, label in pairs(g.vehicles) do
+                if type(model) == 'string' and not isComment(model) and type(label) == 'string' then
+                    cfg.garage.vehicles[model] = label
+                end
+            end
+        end
+        if type(g.maxDistance) == 'number' and g.maxDistance > 0 then cfg.garage.maxDistance = g.maxDistance end
+    end
+    if type(qb.armories) == 'table' then
+        cfg.armories = {}
+        for id, armory in pairs(qb.armories) do
+            if type(id) == 'string' and not isComment(id) then
+                if id:find(ARMORY_ID) and type(armory) == 'table' and M.xyz(armory.coords)
+                    and type(armory.items) == 'table' then
+                    cfg.armories[id] = copy(armory)
+                else
+                    warnOnce('config/police.json: armory "%s" needs coords [x, y, z] and items; ignored', id)
+                end
+            end
+        end
+    end
+    if type(qb.qbShops) == 'table' then
+        cfg.qbShops = {}
+        for shopType, armoryId in pairs(qb.qbShops) do
+            if type(shopType) == 'string' and not isComment(shopType) and type(armoryId) == 'string' then
+                cfg.qbShops[shopType] = armoryId
+            end
+        end
+    end
+    local maxFine = M.int(qb.maxFine)
+    if maxFine and maxFine >= 1 then cfg.maxFine = maxFine end
+    return cfg
+end
+
+local config = nil
+
+--- The active configuration (loaded once; reloaded after fredpd_core restarts).
+function M.config()
+    if config then return config end
+    local raw = LoadResourceFile(M.CORE, M.CONFIG_FILE)
+    local decoded = nil
+    if type(raw) == 'string' and raw ~= '' then
+        local ok, value = pcall(json.decode, raw)
+        if ok and type(value) == 'table' then
+            decoded = value
+        else
+            warnOnce('%s/%s is not valid JSON; using the built-in defaults', M.CORE, M.CONFIG_FILE)
+        end
+    end
+    config = M.buildConfig(decoded)
+    return config
+end
+
+function M.resetConfig()
+    config = nil
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- fredpd_core bridge
+
+--- true while fredpd_core runs: FredPD decides duty and permissions.
+function M.active()
+    return GetResourceState(M.CORE) == 'started'
+end
+
+--- pcall'd export call (exports raise when the resource stops between the state check and the call).
+function M.callExport(resource, fn, ...)
+    local args = table.pack(...)
+    local ok, result = pcall(function()
+        local res = exports[resource]
+        return res[fn](res, table.unpack(args, 1, args.n))
+    end)
+    if not ok then
+        warnOnce('exports.%s:%s failed: %s', resource, fn, tostring(result))
+        return nil, 'error'
+    end
+    return result
+end
+
+function M.isOnDuty(src)
+    return M.callExport(M.CORE, 'isOnDuty', src) == true
+end
+
+function M.hasGrant(src, grantType, key)
+    return M.callExport(M.CORE, 'hasGrant', src, grantType, key) == true
+end
+
+--- Fire-and-forget fredpd_audit row (docs/contracts.md C9 audit export); nothing while fredpd_core is not started.
+function M.audit(src, action, targetType, targetId, meta)
+    if not M.active() then return end
+    M.callExport(M.CORE, 'audit', src, action, targetType, targetId, meta)
+end
+
+--- Grant needed for an action: { type, key }; false = on duty is enough; nil = not mapped (refused).
+function M.grantFor(action)
+    local spec = M.config().actions[action]
+    if spec == 'duty' then return false end
+    local grantType, key = M.parseGrant(spec)
+    if not grantType then return nil end
+    return { grantType, key }
+end
+
+--- FredPD's answer to "is src an on-duty officer allowed to do <action>?" (action nil = on duty only).
+--- @return boolean|nil allowed nil while fredpd_core is not started: the caller applies qb-policejob's own check
+--- @return string|nil reason 'off_duty' | 'no_grant'
+function M.check(src, action)
+    if not M.active() then return nil end
+    src = tonumber(src)
+    if not src or not M.isOnDuty(src) then return false, 'off_duty' end
+    if action == nil then return true end
+    local grant = M.grantFor(action)
+    if grant == false then return true end
+    if grant == nil then
+        warnOnce('qb-policejob action "%s" has no grant in config/police.json; it is refused', tostring(action))
+        return false, 'no_grant'
+    end
+    if M.hasGrant(src, grant[1], grant[2]) then return true end
+    return false, 'no_grant'
+end
+
+--- The gate every patched handler uses: FredPD's answer while fredpd_core runs, else the upstream condition.
+--- @param upstreamOk boolean what unpatched qb-policejob would have decided at this place
+function M.allowed(src, action, upstreamOk)
+    local ok = M.check(src, action)
+    if ok == nil then return upstreamOk == true end
+    return ok
+end
+
+--- Locale key to show when src was refused <action>.
+function M.deniedKey(src, action)
+    local _, reason = M.check(src, action)
+    return reason == 'no_grant' and 'fredpd.no_permission' or 'error.on_duty_police_only'
+end
+
+function M.notify(src, key, kind, subs)
+    TriggerClientEvent('QBCore:Notify', src, Lang:t(key, subs), kind)
+end
+
+--- Tell src why <action> was refused.
+function M.deny(src, action)
+    M.notify(src, M.deniedKey(src, action), 'error')
+end
+
+--- The qb-core player object (nil when not loaded).
+function M.player(src)
+    local ok, player = pcall(function() return exports['qb-core']:GetPlayer(tonumber(src)) end)
+    if ok and type(player) == 'table' then return player end
+    return nil
+end
+
+--- qb-policejob's usual upstream condition: a 'leo' job on duty.
+function M.leoOnDuty(player)
+    local job = type(player) == 'table' and player.PlayerData and player.PlayerData.job
+    return type(job) == 'table' and job.type == 'leo' and job.onduty == true
+end
+
+function M.isLeo(player)
+    local job = type(player) == 'table' and player.PlayerData and player.PlayerData.job
+    return type(job) == 'table' and job.type == 'leo'
+end
+
+--- Does the built-in evidence of qb-policejob stay on? Off only while fredpd_core runs and reports the FredPD
+--- evidence feature (noobsystems/evidences + fredpd_forensics, which need ox_inventory + ox_target), so on a
+--- qb-inventory server the built-in evidence keeps working. Used by patch 20.
+function M.evidenceReplaced()
+    if not M.active() then return false end
+    return M.callExport(M.CORE, 'hasFeature', 'evidence') == true
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- Rate limit (per player and key, cleared on disconnect)
+
+local lastCall = {}
+
+function M.rateLimit(src, key, ms)
+    src = tonumber(src)
+    if not src then return false end
+    local now = GetGameTimer()
+    local calls = lastCall[src]
+    if not calls then
+        calls = {}
+        lastCall[src] = calls
+    end
+    local last = calls[key]
+    if last and now - last < ms then return false end
+    calls[key] = now
+    return true
+end
+
+function M.forget(src)
+    lastCall[tonumber(src) or src] = nil
+end
+
+--- Sanitised spike strip list of police:server:SyncSpikes (client/objects.lua:213-233, 290-292): entries
+--- { coords, netid, object } with numbers only, at most `max` of them; nil when the list is not acceptable.
+function M.spikeList(list, max)
+    if type(list) ~= 'table' then return nil end
+    local out, n = {}, 0
+    max = M.int(max) or 5
+    for key, spike in pairs(list) do
+        if not M.int(key) or type(spike) ~= 'table' or not M.int(spike.netid) or not M.xyz(spike.coords) then
+            return nil
+        end
+        n = n + 1
+        if n > max then return nil end
+        out[key] = { coords = spike.coords, netid = spike.netid, object = M.int(spike.object) }
+    end
+    return out
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- Extension points for later FredPD patches (patch 30 adds fredpd/server_bolo.lua)
+
+M.impoundHooks = {}
+
+--- A vehicle was impounded by src (after the upstream database update): audit it and run the impound hooks.
+function M.afterImpound(src, plate, fullImpound, price, owned)
+    local normalized = M.normalizePlate(plate)
+    M.audit(src, 'police.impound', 'vehicle', normalized or tostring(plate),
+        { full = fullImpound == true, price = price, owned = owned == true })
+    for _, hook in ipairs(M.impoundHooks) do
+        local ok, err = pcall(hook, src, plate, fullImpound == true)
+        if not ok then warnOnce('impound hook failed: %s', tostring(err)) end
+    end
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- Garage (qb-policejob config.lua AuthorizedVehicles / PoliceHelicopter / Locations)
+
+local function lower(s)
+    return type(s) == 'string' and s:lower() or nil
+end
+
+--- Upstream garage list for a qb grade: AuthorizedVehicles[0..grade] ({ [model] = label }, client/job.lua:207-225).
+function M.upstreamGarage(grade)
+    local out = {}
+    grade = M.int(grade) or 0
+    for g, list in pairs(Config.AuthorizedVehicles or {}) do
+        if type(g) == 'number' and g <= grade and type(list) == 'table' then
+            for model, label in pairs(list) do out[model] = label end
+        end
+    end
+    return out
+end
+
+--- Every model the garage can offer while FredPD runs: config garage.vehicles, else every AuthorizedVehicles grade.
+function M.garageCandidates()
+    local configured = M.config().garage.vehicles
+    if type(configured) == 'table' and next(configured) then return copy(configured) end
+    local out = {}
+    for _, list in pairs(Config.AuthorizedVehicles or {}) do
+        if type(list) == 'table' then
+            for model, label in pairs(list) do out[model] = label end
+        end
+    end
+    return out
+end
+
+--- Garage menu for src ({ [model] = label }). FredPD: candidates src holds vehicle:<model> for, empty off duty.
+--- fredpd_core not started: the upstream list for the qb grade, for an on-duty leo only.
+function M.garageVehicles(src)
+    local player = M.player(src)
+    if not player then return {} end
+    if not M.active() then
+        if not M.leoOnDuty(player) then return {} end
+        local grade = player.PlayerData.job.grade
+        return M.upstreamGarage(type(grade) == 'table' and grade.level or grade)
+    end
+    if not M.isOnDuty(src) then return {} end
+    local out = {}
+    for model, label in pairs(M.garageCandidates()) do
+        if M.hasGrant(src, 'vehicle', lower(model)) then out[model] = label end
+    end
+    return out
+end
+
+--- The configured location of a kind ('vehicle' | 'helicopter' | 'impound') by index; for the helicopter without
+--- an index the location nearest to the officer (upstream client/job.lua:483-489 spawns where the officer stands).
+function M.location(src, kind, index)
+    local list = type(Config.Locations) == 'table' and Config.Locations[kind] or nil
+    if type(list) ~= 'table' then return nil end
+    index = M.int(index)
+    if index then return list[index] end
+    if kind ~= 'helicopter' then return nil end
+    local best, bestDistance = nil, math.huge
+    for _, location in ipairs(list) do
+        local d = M.playerDistance(src, location)
+        if d < bestDistance then best, bestDistance = location, d end
+    end
+    return best
+end
+
+--- A plate the police garage makes: prefix + 4 digits (client/job.lua:180 Lang 'info.police_plate', :493 'ZULU').
+function M.makePlate(prefix)
+    return ('%s%04d'):format(prefix, math.random(1000, 9999))
+end
+
+--- Server decision for callback police:server:fredpdSpawnVehicle (the patched client no longer uses qb-core's
+--- unchecked QBCore:Server:SpawnVehicle for the police garage). The client names only the kind, the model, the
+--- location index and (impound) the plate; coordinates come from config.lua.
+--- @return table|nil spawn { model, coords, plate } or nil, error
+function M.spawnRequest(src, kind, model, index, plate)
+    if type(model) ~= 'string' or model == '' or #model > 64 then return nil, 'invalid' end
+    if not M.rateLimit(src, 'garage.spawn', 2000) then return nil, 'rate_limited' end
+    local player = M.player(src)
+    if not player then return nil, 'invalid' end
+    local locationKind = ({ garage = 'vehicle', helicopter = 'helicopter', impound = 'impound' })[kind]
+    if not locationKind then return nil, 'invalid' end
+    local coords = M.location(src, locationKind, index)
+    if not coords then return nil, 'invalid' end
+    if M.playerDistance(src, coords) > M.config().garage.maxDistance then return nil, 'too_far' end
+    local fredpd = M.active()
+    if kind == 'garage' then
+        if fredpd then
+            if not M.isOnDuty(src) then return nil, 'off_duty' end
+            if not M.garageCandidates()[model] or not M.hasGrant(src, 'vehicle', lower(model)) then
+                return nil, 'no_grant'
+            end
+        elseif not M.garageVehicles(src)[model] then
+            return nil, M.leoOnDuty(player) and 'no_grant' or 'off_duty'
+        end
+        return { model = model, coords = coords, plate = M.makePlate(Lang:t('info.police_plate')) }
+    elseif kind == 'helicopter' then
+        if lower(model) ~= lower(Config.PoliceHelicopter) then return nil, 'invalid' end
+        if fredpd then
+            if not M.isOnDuty(src) then return nil, 'off_duty' end
+            if not M.hasGrant(src, 'vehicle', lower(model)) then return nil, 'no_grant' end
+        elseif not M.leoOnDuty(player) then
+            return nil, 'off_duty'
+        end
+        return { model = model, coords = coords, plate = M.makePlate('ZULU') }
+    end
+    -- impound take-out: the vehicle row must be impounded (state 2) with this plate and model
+    if not M.allowed(src, 'impound', M.leoOnDuty(player)) then return nil, fredpd and 'no_grant' or 'off_duty' end
+    if type(plate) ~= 'string' or plate == '' or #plate > 16 then return nil, 'invalid' end
+    local stored = MySQL.scalar.await('SELECT vehicle FROM player_vehicles WHERE plate = ? AND state = 2 LIMIT 1',
+        { plate })
+    if stored ~= model then return nil, 'invalid' end
+    return { model = model, coords = coords, plate = plate }
+end
+
+--- Spawn the vehicle of an accepted request (qb-core QBCore.Functions.SpawnVehicle, server/functions.lua:331-356).
+--- @return number|nil netId, string|nil plate
+function M.spawnVehicle(src, kind, model, index, plate)
+    local spawn, err = M.spawnRequest(src, kind, model, index, plate)
+    if not spawn then
+        if err == 'no_grant' then
+            M.notify(src, 'fredpd.no_permission', 'error')
+        elseif err == 'off_duty' then
+            M.notify(src, 'error.on_duty_police_only', 'error')
+        end
+        return nil
+    end
+    local veh = QBCore.Functions.SpawnVehicle(src, spawn.model, spawn.coords, true)
+    if not veh or veh == 0 or not DoesEntityExist(veh) then return nil end
+    SetVehicleNumberPlateText(veh, spawn.plate)
+    return NetworkGetNetworkIdFromEntity(veh), spawn.plate
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- Armory (FredPD armories from config/police.json; qb-inventory shops listed in qbShops are hooked)
+
+local sharedItems = nil
+
+--- qb-core shared item (cached; qb-core GetShared, server/functions.lua). nil when unknown.
+function M.item(name)
+    if type(name) ~= 'string' then return nil end
+    if not sharedItems then
+        local ok, items = pcall(function() return exports['qb-core']:GetShared('Items') end)
+        sharedItems = ok and type(items) == 'table' and items or nil
+        if not sharedItems then return nil end
+    end
+    local item = sharedItems[name:lower()]
+    return type(item) == 'table' and item or nil
+end
+
+function M.resetItems()
+    sharedItems = nil
+end
+
+--- May src take this item? Weapons need weapon:<item name>, everything else armory:<item name> (lower case).
+function M.itemAllowed(src, name)
+    if type(name) ~= 'string' then return false end
+    local key = name:lower()
+    if key:sub(1, 7) == 'weapon_' then return M.hasGrant(src, 'weapon', key) end
+    return M.hasGrant(src, 'armory', key)
+end
+
+--- Armory positions for the client zones: { { id, label, coords = { x, y, z }, radius } } (empty while inactive).
+function M.armoryPoints()
+    local out = {}
+    if not M.active() then return out end
+    for id, armory in pairs(M.config().armories) do
+        local x, y, z = M.xyz(armory.coords)
+        out[#out + 1] = { id = id, coords = { x = x, y = y, z = z }, radius = tonumber(armory.radius) or 1.5 }
+    end
+    table.sort(out, function(a, b) return a.id < b.id end)
+    return out
+end
+
+--- Common checks for opening and taking: armory exists, fredpd_core runs, on duty, armory grant, in reach.
+--- @return table|nil armory, string|nil error 'unavailable' | 'off_duty' | 'no_grant' | 'too_far'
+local function armoryFor(src, id)
+    if not M.active() then return nil, 'unavailable' end
+    local armory = type(id) == 'string' and M.config().armories[id] or nil
+    if not armory then return nil, 'unavailable' end
+    if not M.isOnDuty(src) then return nil, 'off_duty' end
+    if not M.hasGrant(src, 'armory', id) then return nil, 'no_grant' end
+    if M.playerDistance(src, armory.coords) > (tonumber(armory.radius) or 1.5) + 3.0 then return nil, 'too_far' end
+    return armory
+end
+
+--- Callback police:server:fredpdArmory: { id, label, items = { { name, label, count } } } or nil, error.
+--- Only the items src holds a grant for are sent.
+function M.openArmory(src, id)
+    if not M.rateLimit(src, 'armory.open', 500) then return nil, 'rate_limited' end
+    local armory, err = armoryFor(src, id)
+    if not armory then return nil, err end
+    local items = {}
+    for _, entry in ipairs(armory.items) do
+        if type(entry) == 'table' and M.itemAllowed(src, entry.name) then
+            local item = M.item(entry.name)
+            if item then
+                items[#items + 1] = { name = item.name, label = item.label or item.name,
+                    count = M.int(entry.count) or 1 }
+            else
+                warnOnce('armory "%s": qb-core has no item "%s"', id, tostring(entry.name))
+            end
+        end
+    end
+    return { id = id, label = armory.label or id, items = items }
+end
+
+--- Callback police:server:fredpdArmoryTake: hands out one configured amount of an item after checking everything
+--- again (the client may send any item name) and the item's `max` (what the officer already carries).
+--- true or nil, error. Items are signed out, not bought; every take is audited.
+function M.takeFromArmory(src, id, name)
+    if not M.rateLimit(src, 'armory.take', 1000) then return nil, 'rate_limited' end
+    local armory, err = armoryFor(src, id)
+    if not armory then return nil, err end
+    local entry = nil
+    for _, item in ipairs(armory.items) do
+        if type(item) == 'table' and type(name) == 'string' and type(item.name) == 'string'
+            and item.name:lower() == name:lower() then
+            entry = item
+            break
+        end
+    end
+    if not entry then return nil, 'unavailable' end
+    if not M.itemAllowed(src, entry.name) then return nil, 'no_grant' end
+    local item = M.item(entry.name)
+    if not item then return nil, 'unavailable' end
+    local count = M.int(entry.count) or 1
+    if count < 1 then return nil, 'unavailable' end
+    local inv = exports[M.INVENTORY]
+    local max = M.int(entry.max)
+    if max and (inv:GetItemCount(src, item.name) or 0) >= max then return nil, 'limit' end
+    if not inv:CanAddItem(src, item.name, count) then return nil, 'full' end
+    local info = type(entry.info) == 'table' and copy(entry.info) or {}
+    if not inv:AddItem(src, item.name, count, false, info, 'qb-policejob:fredpd-armory') then return nil, 'failed' end
+    TriggerClientEvent('qb-inventory:client:ItemBox', src, item, 'add')
+    M.audit(src, 'police.armory', 'item', item.name:lower(), { armory = id, count = count })
+    return true
+end
+
+--- qb-inventory ShopOpened / ItemBought hook (qb-inventory server/functions.lua:611-612, server/main.lua:456-457:
+--- fn(shopType, payload)) for the shop types in qbShops. Returns false to refuse; nil = no opinion (always nil while
+--- fredpd_core is not started, so the shop keeps its upstream rules).
+function M.shopHook(shopType, payload)
+    if not M.active() or type(payload) ~= 'table' then return nil end
+    local armoryId = M.config().qbShops[shopType]
+    if not armoryId then return nil end
+    local src = tonumber(payload.source or payload.toId)
+    if not src then return false end
+    local itemName = type(payload.item) == 'table' and payload.item.name or nil
+    local allowed = M.isOnDuty(src) and M.hasGrant(src, 'armory', armoryId)
+        and (itemName == nil or M.itemAllowed(src, itemName))
+    if allowed then return nil end
+    M.notify(src, 'fredpd.no_permission', 'error')
+    return false
+end
+
+local hookIds = nil
+
+--- Register the qb-inventory hooks (once per qb-inventory start; qb-inventory drops a stopped resource's hooks,
+--- server/main.lua:147-166). Needs a non-empty qbShops.
+function M.registerInventoryHooks()
+    if hookIds or GetResourceState(M.INVENTORY) ~= 'started' then return false end
+    if not next(M.config().qbShops) then return false end
+    local ok, err = pcall(function()
+        local inv = exports[M.INVENTORY]
+        hookIds = {
+            ShopOpened = inv:AddHook('ShopOpened', M.shopHook),
+            ItemBought = inv:AddHook('ItemBought', M.shopHook),
+        }
+    end)
+    if not ok then
+        hookIds = nil
+        warnOnce('could not register the qb-inventory armory hooks: %s', tostring(err))
+        return false
+    end
+    return true
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- Wiring (runs once when fxmanifest loads this file, after server/main.lua has set the global QBCore)
+
+function M.register()
+    QBCore.Functions.CreateCallback('police:server:fredpdGarageVehicles', function(source, cb)
+        local src = source
+        if not M.rateLimit(src, 'garage.list', 500) then return cb({}) end
+        cb(M.garageVehicles(src))
+    end)
+    QBCore.Functions.CreateCallback('police:server:fredpdSpawnVehicle', function(source, cb, kind, model, index, plate)
+        local src = source
+        cb(M.spawnVehicle(src, kind, model, index, plate))
+    end)
+    QBCore.Functions.CreateCallback('police:server:fredpdArmories', function(_, cb)
+        cb(M.armoryPoints())
+    end)
+    QBCore.Functions.CreateCallback('police:server:fredpdArmory', function(source, cb, id)
+        local src = source
+        cb(M.openArmory(src, id))
+    end)
+    QBCore.Functions.CreateCallback('police:server:fredpdArmoryTake', function(source, cb, id, name)
+        local src = source
+        cb(M.takeFromArmory(src, id, name))
+    end)
+
+    AddEventHandler('onServerResourceStart', function(resource)
+        if resource == M.CORE then
+            M.resetConfig()
+            M.registerInventoryHooks()
+            TriggerClientEvent('police:client:fredpdArmories', -1)
+        elseif resource == M.INVENTORY then
+            hookIds = nil
+            M.registerInventoryHooks()
+        elseif resource == 'qb-core' then
+            M.resetItems()
+        end
+    end)
+    AddEventHandler('onServerResourceStop', function(resource)
+        if resource == M.CORE then TriggerClientEvent('police:client:fredpdArmories', -1) end
+    end)
+    AddEventHandler('playerDropped', function()
+        M.forget(source)
+    end)
+    M.registerInventoryHooks()
+end
+
+FredPD = M
+M.register()
