index 0000000..0dbc2eb
--- /dev/null
+++ b/fredpd/server.lua
@@ -0,0 +1,591 @@
+-- SPDX-License-Identifier: GPL-3.0-only
+-- FredPD bridge for qbx_police, added by FredPD's patches/qbx_policejob.10-grants.patch (docs/modules/police.md in
+-- the FredPD repository). Loaded with ox_lib `require 'fredpd.server'` from server/main.lua and server/commands.lua.
+--
+-- While fredpd_core is started, duty and permissions come from FredPD (exports.fredpd_core:isOnDuty / hasGrant,
+-- grants from Discord roles) instead of qbx job grades, and the police garage and armory only offer granted
+-- vehicles and items (re-checked when they are handed out). While fredpd_core is not started, `check` answers nil
+-- and every other entry point lets the upstream behaviour through, so the patch never bricks the job.
+-- Plain Lua 5.4 (no cfxlua syntax); unit-tested by tests/lua/police_*_test.lua in the FredPD repository.
+
+local M = {}
+
+M.CORE = 'fredpd_core'
+M.CONFIG_FILE = 'config/police.json'
+
+--- Grant types of docs/contracts.md C2.
+M.GRANT_TYPES = {
+    weapon = true, vehicle = true, armory = true, tool = true, mdt_page = true, intel_tier = true, unit = true,
+    perm = true,
+}
+
+--- Built-in configuration; FredPD's config/police.json (copied to fredpd_core/config/) overrides it key by key.
+--- actions: qbx_police action -> 'type:key' grant, or 'duty' (on duty is enough). An action without a valid entry is
+--- refused (fail closed) while fredpd_core runs.
+M.DEFAULTS = {
+    actions = {
+        anklet = 'duty',
+        bill = 'perm:charges.fine',
+        camera = 'duty',
+        cuff = 'duty',
+        fine = 'perm:charges.fine',
+        flagplate = 'perm:bolo.create',
+        impound = 'perm:police.impound',
+        jail = 'perm:police.jail',
+        license = 'perm:police.license',
+        object = 'duty',
+        paylawyer = 'duty',
+        paytow = 'duty',
+        plateinfo = 'duty',
+        seizecash = 'duty',
+        spikestrip = 'duty',
+        tracker = 'duty',
+        unflagplate = 'perm:bolo.resolve',
+    },
+    garage = { vehicles = {}, helicopter = 'polmav', maxDistance = 15 },
+    armories = {
+        mrpd = {
+            label = 'Mission Row',
+            coords = { 462.23, -981.12, 30.68 },
+            radius = 1.5,
+            -- max: no take while the officer already carries that many (ox_inventory GetItemCount); nil = no limit
+            items = {
+                { name = 'WEAPON_PISTOL', count = 1, max = 1, metadata = { serial = 'POL' } },
+                { name = 'WEAPON_STUNGUN', count = 1, max = 1, metadata = { serial = 'POL' } },
+                { name = 'WEAPON_NIGHTSTICK', count = 1, max = 1 },
+                { name = 'WEAPON_FLASHLIGHT', count = 1, max = 1 },
+                { name = 'WEAPON_CARBINERIFLE', count = 1, max = 1, metadata = { serial = 'POL' } },
+                { name = 'ammo-9', count = 50, max = 150 },
+                { name = 'ammo-rifle', count = 60, max = 180 },
+                { name = 'handcuffs', count = 1, max = 2 },
+            },
+        },
+    },
+    oxShops = { PoliceArmoury = 'mrpd' },
+    radar = { cooldownSeconds = 60, maxDistance = 50 },
+}
+
+local GRANT_KEY = '^[A-Za-z0-9_%.:%*%-]+$'
+local ARMORY_ID = '^[%w_%-]+$'
+
+---------------------------------------------------------------------------------------------------------------
+-- Small helpers
+
+local warned = {}
+
+--- One console warning per distinct message (no log spam from a hot path).
+local function warnOnce(fmt, ...)
+    local msg = fmt:format(...)
+    if warned[msg] then return end
+    warned[msg] = true
+    local printer = type(lib) == 'table' and type(lib.print) == 'table' and lib.print.warn
+    if printer then printer(msg) else print('[qbx_policejob] ' .. msg) end
+end
+
+local function copy(value)
+    if type(value) ~= 'table' then return value end
+    local out = {}
+    for k, v in pairs(value) do out[k] = copy(v) end
+    return out
+end
+
+--- Parse 'type:key' into type, key (nil when malformed or an unknown type).
+function M.parseGrant(spec)
+    if type(spec) ~= 'string' then return nil end
+    local grantType, key = spec:match('^([%w_]+):(.+)$')
+    if not grantType or not M.GRANT_TYPES[grantType] or #key > 64 or not key:find(GRANT_KEY) then return nil end
+    return grantType, key
+end
+
+--- Plate as FredPD stores it (docs/contracts.md C4 detectSearchType): upper case, no whitespace; nil when unusable.
+function M.normalizePlate(plate)
+    if type(plate) ~= 'string' then return nil end
+    local normalized = plate:upper():gsub('%s+', '')
+    if normalized == '' or #normalized > 16 or not normalized:find('^[%w%-]+$') then return nil end
+    return normalized
+end
+
+--- x, y, z of a vector3/vector4, a { x, y, z } table or a { [1], [2], [3] } array (nil when not all numbers).
+function M.xyz(v)
+    if type(v) ~= 'table' and type(v) ~= 'userdata' and type(v) ~= 'vector3' and type(v) ~= 'vector4' then
+        return nil
+    end
+    local ok, x, y, z = pcall(function() return v.x or v[1], v.y or v[2], v.z or v[3] end)
+    if ok and type(x) == 'number' and type(y) == 'number' and type(z) == 'number'
+        and x == x and y == y and z == z then
+        return x, y, z
+    end
+    return nil
+end
+
+function M.distance(a, b)
+    local ax, ay, az = M.xyz(a)
+    local bx, by, bz = M.xyz(b)
+    if not ax or not bx then return math.huge end
+    return math.sqrt((ax - bx) ^ 2 + (ay - by) ^ 2 + (az - bz) ^ 2)
+end
+
+--- Metres between a player and a point (math.huge when unknown).
+function M.playerDistance(src, point)
+    local ped = GetPlayerPed(src)
+    if not ped or ped == 0 then return math.huge end
+    return M.distance(GetEntityCoords(ped), point)
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- Configuration
+
+--- Merge a decoded config/police.json over the defaults. Unknown or malformed entries are warned about and dropped.
+function M.buildConfig(decoded)
+    local cfg = copy(M.DEFAULTS)
+    if type(decoded) ~= 'table' then return cfg end
+    if type(decoded.actions) == 'table' then
+        for action, spec in pairs(decoded.actions) do
+            if type(action) == 'string' and action:sub(1, 1) ~= '$' then
+                if spec == 'duty' or M.parseGrant(spec) then
+                    cfg.actions[action] = spec
+                else
+                    warnOnce('config/police.json: action "%s" has an invalid grant %s; the action is refused',
+                        action, tostring(spec))
+                    cfg.actions[action] = nil
+                end
+            end
+        end
+    end
+    if type(decoded.garage) == 'table' then
+        local g = decoded.garage
+        if type(g.vehicles) == 'table' then
+            cfg.garage.vehicles = {}
+            for model, label in pairs(g.vehicles) do
+                if type(model) == 'string' and model:sub(1, 1) ~= '$' and type(label) == 'string' then
+                    cfg.garage.vehicles[model] = label
+                end
+            end
+        end
+        if type(g.helicopter) == 'string' then cfg.garage.helicopter = g.helicopter end
+        if type(g.maxDistance) == 'number' and g.maxDistance > 0 then cfg.garage.maxDistance = g.maxDistance end
+    end
+    if type(decoded.armories) == 'table' then
+        cfg.armories = {}
+        for id, armory in pairs(decoded.armories) do
+            if type(id) == 'string' and id:sub(1, 1) ~= '$' then
+                if id:find(ARMORY_ID) and type(armory) == 'table' and M.xyz(armory.coords)
+                    and type(armory.items) == 'table' then
+                    cfg.armories[id] = copy(armory)
+                else
+                    warnOnce('config/police.json: armory "%s" needs coords [x, y, z] and items; ignored', id)
+                end
+            end
+        end
+    end
+    if type(decoded.oxShops) == 'table' then
+        cfg.oxShops = {}
+        for shopType, armoryId in pairs(decoded.oxShops) do
+            if type(shopType) == 'string' and shopType:sub(1, 1) ~= '$' and type(armoryId) == 'string' then
+                cfg.oxShops[shopType] = armoryId
+            end
+        end
+    end
+    if type(decoded.radar) == 'table' then
+        for _, key in ipairs({ 'cooldownSeconds', 'maxDistance' }) do
+            local v = decoded.radar[key]
+            if type(v) == 'number' and v >= 0 then cfg.radar[key] = v end
+        end
+    end
+    return cfg
+end
+
+local config = nil
+
+--- The active configuration (loaded once; reloaded after fredpd_core restarts).
+function M.config()
+    if config then return config end
+    local raw = LoadResourceFile(M.CORE, M.CONFIG_FILE)
+    local decoded = nil
+    if type(raw) == 'string' and raw ~= '' then
+        local ok, value = pcall(json.decode, raw)
+        if ok and type(value) == 'table' then
+            decoded = value
+        else
+            warnOnce('%s/%s is not valid JSON; using the built-in defaults', M.CORE, M.CONFIG_FILE)
+        end
+    end
+    config = M.buildConfig(decoded)
+    return config
+end
+
+function M.resetConfig()
+    config = nil
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- fredpd_core bridge
+
+--- true while fredpd_core runs: FredPD decides duty and permissions.
+function M.active()
+    return GetResourceState(M.CORE) == 'started'
+end
+
+--- pcall'd export call (exports raise when the resource stops between the state check and the call).
+function M.callExport(resource, fn, ...)
+    local args = table.pack(...)
+    local ok, result = pcall(function()
+        local res = exports[resource]
+        return res[fn](res, table.unpack(args, 1, args.n))
+    end)
+    if not ok then
+        warnOnce('exports.%s:%s failed: %s', resource, fn, tostring(result))
+        return nil, 'error'
+    end
+    return result
+end
+
+function M.isOnDuty(src)
+    return M.callExport(M.CORE, 'isOnDuty', src) == true
+end
+
+function M.hasGrant(src, grantType, key)
+    return M.callExport(M.CORE, 'hasGrant', src, grantType, key) == true
+end
+
+--- Fire-and-forget fredpd_audit row (docs/contracts.md C9 audit export); nothing while fredpd_core is not started.
+function M.audit(src, action, targetType, targetId, meta)
+    if not M.active() then return end
+    M.callExport(M.CORE, 'audit', src, action, targetType, targetId, meta)
+end
+
+--- Grant needed for an action: { type, key }; false = on duty is enough; nil = not mapped (refused).
+function M.grantFor(action)
+    local spec = M.config().actions[action]
+    if spec == 'duty' then return false end
+    local grantType, key = M.parseGrant(spec)
+    if not grantType then return nil end
+    return { grantType, key }
+end
+
+--- Action name for an upstream minimum grade without an explicit action (unmapped unless configured).
+function M.gradeAction(minGrade)
+    if type(minGrade) == 'number' and minGrade > 0 then return ('grade%d'):format(math.floor(minGrade)) end
+    return nil
+end
+
+--- FredPD's answer to "is src an on-duty officer allowed to do <action>?" (action nil = on duty only).
+--- @return boolean|nil allowed nil while fredpd_core is not started: the caller applies qbx_police's own check
+--- @return string|nil reason 'off_duty' | 'no_grant'
+function M.check(src, action)
+    if not M.active() then return nil end
+    src = tonumber(src)
+    if not src or not M.isOnDuty(src) then return false, 'off_duty' end
+    if action == nil then return true end
+    local grant = M.grantFor(action)
+    if grant == false then return true end
+    if grant == nil then
+        warnOnce('qbx_police action "%s" has no grant in config/police.json; it is refused', tostring(action))
+        return false, 'no_grant'
+    end
+    if M.hasGrant(src, grant[1], grant[2]) then return true end
+    return false, 'no_grant'
+end
+
+--- Locale key to show when src was refused <action>.
+function M.deniedKey(src, action)
+    local _, reason = M.check(src, action)
+    return reason == 'no_grant' and 'fredpd.no_permission' or 'error.on_duty_police_only'
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- Rate limit (per player and key, cleared on disconnect)
+
+local lastCall = {}
+
+function M.rateLimit(src, key, ms)
+    src = tonumber(src)
+    if not src then return false end
+    local now = GetGameTimer()
+    local calls = lastCall[src]
+    if not calls then
+        calls = {}
+        lastCall[src] = calls
+    end
+    local last = calls[key]
+    if last and now - last < ms then return false end
+    calls[key] = now
+    return true
+end
+
+function M.forget(src)
+    lastCall[tonumber(src) or src] = nil
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- Garage (qbx_police config/client.lua authorizedVehicles / whitelistedVehicles)
+
+local function lower(s)
+    return type(s) == 'string' and s:lower() or nil
+end
+
+--- qbx_police's config/client.lua (authorizedVehicles, whitelistedVehicles, policeHelicopter, radars) and
+--- config/shared.lua (locations, policePlatePrefix); set by M.register.
+M.upstream = {}
+M.shared = {}
+
+--- Metres a spawn point may be from a configured garage/helicopter/impound location (the helicopter spawns at the
+--- officer inside the 4 m zone around locations.helicopter, client/job.lua:199-203 and 496-500).
+M.SPAWN_TOLERANCE = 5.0
+
+--- Upstream list for a qbx grade: authorizedVehicles[grade] + whitelistedVehicles ({ [model] = label }).
+function M.upstreamGarage(grade)
+    local out = {}
+    local byGrade = M.upstream.authorizedVehicles and M.upstream.authorizedVehicles[grade]
+    for model, label in pairs(byGrade or {}) do out[model] = label end
+    for model, label in pairs(M.upstream.whitelistedVehicles or {}) do out[model] = label end
+    return out
+end
+
+--- Every model the garage can offer: config/police.json garage.vehicles, else all grades + whitelisted upstream.
+function M.garageCandidates()
+    local configured = M.config().garage.vehicles
+    if type(configured) == 'table' and next(configured) then return copy(configured) end
+    local out = {}
+    for _, list in pairs(M.upstream.authorizedVehicles or {}) do
+        for model, label in pairs(list) do out[model] = label end
+    end
+    for model, label in pairs(M.upstream.whitelistedVehicles or {}) do out[model] = label end
+    return out
+end
+
+function M.helicopterModel()
+    return M.config().garage.helicopter or M.upstream.policeHelicopter or 'polmav'
+end
+
+--- Garage menu for src ({ [model] = label }). While fredpd_core is not started: the upstream list for the qbx
+--- grade, for an on-duty leo only (upstream only lets them into the garage zone, client/job.lua:546).
+function M.garageVehicles(src, player)
+    if not M.active() then
+        local job = player and player.PlayerData and player.PlayerData.job
+        if not job or job.type ~= 'leo' or not job.onduty then return {} end
+        return M.upstreamGarage(job.grade and job.grade.level)
+    end
+    if not M.isOnDuty(src) then return {} end
+    local out = {}
+    for model, label in pairs(M.garageCandidates()) do
+        if M.hasGrant(src, 'vehicle', lower(model)) then out[model] = label end
+    end
+    return out
+end
+
+--- Is point within M.SPAWN_TOLERANCE metres of one of the locations (a vec3/vec4 list of config/shared.lua)?
+function M.nearLocation(point, locations)
+    if type(locations) ~= 'table' then return false end
+    for _, location in pairs(locations) do
+        if M.distance(point, location) <= M.SPAWN_TOLERANCE then return true end
+    end
+    return false
+end
+
+--- A plate the police garage itself makes: prefix + letters/digits, at most 8 characters (client/job.lua:85-89
+--- policePlatePrefix + random digits; :203 'ZULU' + 4 digits for the helicopter).
+function M.policePlate(plate, prefix)
+    return type(plate) == 'string' and type(prefix) == 'string' and prefix ~= '' and #plate <= 8
+        and plate:sub(1, #prefix) == prefix and plate:find('^%w+$') ~= nil
+end
+
+--- A garage or helicopter spawn as the upstream client makes it: the model offered there, at that location, with
+--- a police plate (so a granted officer cannot spawn a car anywhere with a copy of a civilian plate).
+function M.garageSpawnValid(model, coords, plate)
+    local locations = type(M.shared.locations) == 'table' and M.shared.locations or {}
+    if model == M.helicopterModel() and M.nearLocation(coords, locations.helicopter)
+        and M.policePlate(plate, 'ZULU') then
+        return true
+    end
+    return M.garageCandidates()[model] ~= nil and M.nearLocation(coords, locations.vehicle)
+        and M.policePlate(plate, M.shared.policePlatePrefix or 'LSPD')
+end
+
+--- Server re-check of lib callback qbx_policejob:server:spawnVehicle (true = spawn). Always true while fredpd_core
+--- is not started (upstream has no check). giveKeys == true: garage or helicopter (client/job.lua:90, 203) at a
+--- config/shared.lua vehicle/helicopter location with a police plate; otherwise an impound take-out (client/job.lua:65
+--- passes the row id there) at an impound location, which needs perm impound and a player_vehicles row with that
+--- plate and model in state 2.
+function M.canSpawn(src, model, coords, plate, giveKeys)
+    if not M.active() then return true end
+    if type(model) ~= 'string' or model == '' or #model > 64 or type(plate) ~= 'string' or #plate > 16 then
+        return false
+    end
+    if not M.rateLimit(src, 'garage.spawn', 2000) then return false end
+    if M.playerDistance(src, coords) > M.config().garage.maxDistance then return false end
+    if not M.isOnDuty(src) then return false end
+    if giveKeys == true then
+        if not M.garageSpawnValid(model, coords, plate) then return false end
+        return M.hasGrant(src, 'vehicle', lower(model))
+    end
+    local locations = type(M.shared.locations) == 'table' and M.shared.locations or {}
+    if not M.nearLocation(coords, locations.impound) then return false end
+    if not M.check(src, 'impound') then return false end
+    local stored = MySQL.scalar.await('SELECT vehicle FROM player_vehicles WHERE plate = ? AND state = 2 LIMIT 1',
+        { plate })
+    return stored == model
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- Armory (FredPD armories from config/police.json; ox_inventory shops listed in oxShops are hooked)
+
+local function itemLabel(name)
+    local ok, item = pcall(function() return exports.ox_inventory:Items(name) end)
+    if ok and type(item) == 'table' and type(item.label) == 'string' then return item.label end
+    return nil
+end
+
+--- May src take this item? Weapons need weapon:<item name>, everything else armory:<item name> (lower case).
+function M.itemAllowed(src, name)
+    if type(name) ~= 'string' then return false end
+    local key = name:lower()
+    if key:sub(1, 7) == 'weapon_' then return M.hasGrant(src, 'weapon', key) end
+    return M.hasGrant(src, 'armory', key)
+end
+
+--- Armory positions for the client zones: { { id, coords = { x, y, z }, radius } } (empty while inactive).
+function M.armoryPoints()
+    local out = {}
+    if not M.active() then return out end
+    for id, armory in pairs(M.config().armories) do
+        local x, y, z = M.xyz(armory.coords)
+        out[#out + 1] = { id = id, coords = { x = x, y = y, z = z }, radius = tonumber(armory.radius) or 1.5 }
+    end
+    table.sort(out, function(a, b) return a.id < b.id end)
+    return out
+end
+
+--- Common checks for opening and taking: armory exists, fredpd_core runs, on duty, armory grant, in reach.
+--- @return table|nil armory, string|nil error 'unavailable' | 'off_duty' | 'no_grant' | 'too_far'
+local function armoryFor(src, id)
+    if not M.active() then return nil, 'unavailable' end
+    local armory = type(id) == 'string' and M.config().armories[id] or nil
+    if not armory then return nil, 'unavailable' end
+    if not M.isOnDuty(src) then return nil, 'off_duty' end
+    if not M.hasGrant(src, 'armory', id) then return nil, 'no_grant' end
+    if M.playerDistance(src, armory.coords) > (tonumber(armory.radius) or 1.5) + 3.0 then return nil, 'too_far' end
+    return armory
+end
+
+--- lib callback qbx_policejob:server:fredpdArmory: { id, label, items = { { name, label, count } } } or nil, error.
+--- Only the items src holds a grant for are sent.
+function M.openArmory(src, id)
+    if not M.rateLimit(src, 'armory.open', 500) then return nil, 'rate_limited' end
+    local armory, err = armoryFor(src, id)
+    if not armory then return nil, err end
+    local items = {}
+    for _, item in ipairs(armory.items) do
+        if type(item) == 'table' and M.itemAllowed(src, item.name) then
+            local label = itemLabel(item.name)
+            if label then
+                items[#items + 1] = { name = item.name, label = label, count = math.tointeger(item.count) or 1 }
+            else
+                warnOnce('armory "%s": ox_inventory has no item "%s"', id, tostring(item.name))
+            end
+        end
+    end
+    return { id = id, label = armory.label or id, items = items }
+end
+
+--- lib callback qbx_policejob:server:fredpdArmoryTake: hands out one configured amount of an item after checking
+--- everything again (the client may send any item name) and the item's `max` (what the officer already carries).
+--- true or nil, error.
+function M.takeFromArmory(src, id, name)
+    if not M.rateLimit(src, 'armory.take', 1000) then return nil, 'rate_limited' end
+    local armory, err = armoryFor(src, id)
+    if not armory then return nil, err end
+    local entry = nil
+    for _, item in ipairs(armory.items) do
+        if type(item) == 'table' and item.name == name then
+            entry = item
+            break
+        end
+    end
+    if not entry then return nil, 'unavailable' end
+    if not M.itemAllowed(src, entry.name) then return nil, 'no_grant' end
+    local count = math.tointeger(entry.count) or 1
+    if count < 1 then return nil, 'unavailable' end
+    local max = math.tointeger(entry.max)
+    if max and (exports.ox_inventory:GetItemCount(src, entry.name) or 0) >= max then return nil, 'limit' end
+    local metadata = type(entry.metadata) == 'table' and copy(entry.metadata) or nil
+    if not exports.ox_inventory:CanCarryItem(src, entry.name, count, metadata) then return nil, 'full' end
+    local ok = exports.ox_inventory:AddItem(src, entry.name, count, metadata)
+    if not ok then return nil, 'failed' end
+    M.audit(src, 'police.armory', 'item', entry.name:lower(), { armory = id, count = count })
+    return true
+end
+
+--- ox_inventory openShop / buyItem hook for the shop types in oxShops. Returns false to refuse; nil = no opinion
+--- (always nil while fredpd_core is not started, so the shop keeps its upstream rules).
+function M.shopHook(payload)
+    if not M.active() or type(payload) ~= 'table' then return nil end
+    local armoryId = M.config().oxShops[payload.shopType]
+    if not armoryId then return nil end
+    local src = payload.source
+    local allowed = M.isOnDuty(src) and M.hasGrant(src, 'armory', armoryId)
+        and (payload.itemName == nil or M.itemAllowed(src, payload.itemName))
+    if allowed then return nil end
+    exports.qbx_core:Notify(src, locale('fredpd.no_permission'), 'error')
+    return false
+end
+
+local hooksRegistered = false
+
+--- Register the ox_inventory hooks (once per ox_inventory start; ox_inventory drops them when either side stops).
+function M.registerInventoryHooks()
+    if hooksRegistered or GetResourceState('ox_inventory') ~= 'started' then return false end
+    local types = {}
+    for shopType in pairs(M.config().oxShops) do types[shopType] = true end
+    if not next(types) then return false end
+    local ok, err = pcall(function()
+        exports.ox_inventory:registerHook('openShop', M.shopHook, { typeFilter = types })
+        exports.ox_inventory:registerHook('buyItem', M.shopHook, { typeFilter = types })
+    end)
+    if not ok then
+        warnOnce('could not register the ox_inventory armory hooks: %s', tostring(err))
+        return false
+    end
+    hooksRegistered = true
+    return true
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- Wiring (runs once, when server/main.lua or server/commands.lua first requires this module)
+
+function M.register(upstreamClient, upstreamShared)
+    M.upstream = type(upstreamClient) == 'table' and upstreamClient or {}
+    M.shared = type(upstreamShared) == 'table' and upstreamShared or {}
+    lib.callback.register('qbx_policejob:server:garageVehicles', function(source)
+        local src = source
+        if not M.rateLimit(src, 'garage.list', 500) then return {} end
+        return M.garageVehicles(src, exports.qbx_core:GetPlayer(src))
+    end)
+    lib.callback.register('qbx_policejob:server:fredpdArmories', function()
+        return M.armoryPoints()
+    end)
+    lib.callback.register('qbx_policejob:server:fredpdArmory', function(source, id)
+        return M.openArmory(source, id)
+    end)
+    lib.callback.register('qbx_policejob:server:fredpdArmoryTake', function(source, id, name)
+        return M.takeFromArmory(source, id, name)
+    end)
+
+    AddEventHandler('onResourceStart', function(resource)
+        if resource == M.CORE then M.resetConfig() end
+    end)
+    AddEventHandler('onServerResourceStart', function(resource)
+        if resource == 'ox_inventory' then
+            hooksRegistered = false
+            M.registerInventoryHooks()
+        end
+    end)
+    AddEventHandler('playerDropped', function()
+        M.forget(source)
+    end)
+    M.registerInventoryHooks()
+end
+
+M.register(require 'config.client', require 'config.shared')
+
+return M
