 local sharedConfig = require 'config.shared'
+-- FredPD (patches/qbx_policejob.10-grants.patch): these callbacks/events were open to any client (any model,
+-- anywhere, any index). Now, in both modes: an on-duty officer (IsLeoAndOnDuty: FredPD duty + the action's grant
+-- while fredpd_core runs, else the upstream leo duty check), within 10 m, one call per 500 ms, only the models of
+-- config/shared.lua objects, and a valid index when removing.
+local FredPD = require 'fredpd.server'
+local objectModels = {}
+for _, object in pairs(sharedConfig.objects) do objectModels[object.model] = true end
+
+---@return boolean allowed, string? error locale key for the client (client/objects.lua shows it)
+local function mayUse(src, action, coords)
+    local player = exports.qbx_core:GetPlayer(src)
+    if not player or not IsLeoAndOnDuty(player, nil, action) then return false, FredPD.deniedKey(src, action) end
+    if coords and FredPD.playerDistance(src, coords) > 10.0 then return false, 'error.canceled' end
+    if not FredPD.rateLimit(src, action, 500) then return false, 'fredpd.try_again' end
+    return true
+end
+
+---@return integer? index a valid position in list
+local function validIndex(list, index)
+    index = math.tointeger(tonumber(index))
+    if not index or type(list) ~= 'table' or index < 1 or index > #list then return nil end
+    return index
+end
+
+---@return vector3? coords of a networked object that still exists
+local function objectCoords(netId)
+    local entity = netId and NetworkGetEntityFromNetworkId(netId)
+    if entity and entity ~= 0 and DoesEntityExist(entity) then return GetEntityCoords(entity) end
+end
 
