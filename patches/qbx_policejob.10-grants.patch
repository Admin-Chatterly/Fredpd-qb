--- /dev/null
+++ b/fredpd/client.lua
@@ -0,0 +1,93 @@
+-- SPDX-License-Identifier: GPL-3.0-only
+-- FredPD armory for qbx_police (client), added by FredPD's patches/qbx_policejob.10-grants.patch.
+-- The server decides everything (fredpd/server.lua): this file only adds the ox_target zones it is given and shows
+-- the item list the server already filtered by the officer's grants; taking an item is checked again server-side.
+-- No loops: the zones are added once at start and again when fredpd_core or ox_target (re)starts.
+
+local zones = {}
+
+local ERRORS = {
+    off_duty = 'error.on_duty_police_only',
+    no_grant = 'fredpd.no_permission',
+    too_far = 'fredpd.armory_too_far',
+    full = 'fredpd.armory_full',
+    limit = 'fredpd.armory_limit',
+    rate_limited = 'fredpd.try_again',
+    unavailable = 'fredpd.armory_unavailable',
+    failed = 'fredpd.armory_failed',
+}
+
+local function notifyError(err)
+    exports.qbx_core:Notify(locale(ERRORS[err] or 'fredpd.armory_failed'), 'error')
+end
+
+local function canUse()
+    local job = QBX.PlayerData and QBX.PlayerData.job
+    return job ~= nil and job.type == 'leo' and job.onduty == true
+end
+
+local function take(armoryId, item)
+    local ok, err = lib.callback.await('qbx_policejob:server:fredpdArmoryTake', false, armoryId, item.name)
+    if ok then
+        exports.qbx_core:Notify(locale('fredpd.armory_taken', item.count, item.label), 'success')
+    else
+        notifyError(err)
+    end
+end
+
+local function openArmory(armoryId)
+    local data, err = lib.callback.await('qbx_policejob:server:fredpdArmory', false, armoryId)
+    if not data then return notifyError(err) end
+    if #data.items == 0 then
+        return exports.qbx_core:Notify(locale('fredpd.armory_empty'), 'inform')
+    end
+    local options = {}
+    for _, item in ipairs(data.items) do
+        options[#options + 1] = {
+            title = item.label,
+            description = locale('fredpd.armory_count', item.count),
+            icon = 'fa-solid fa-box',
+            onSelect = function() take(armoryId, item) end,
+        }
+    end
+    lib.registerContext({ id = 'fredpd_armory', title = locale('fredpd.armory_title', data.label), options = options })
+    lib.showContext('fredpd_armory')
+end
+
+local function clearZones()
+    for i = 1, #zones do
+        local id = zones[i]
+        pcall(function() exports.ox_target:removeZone(id) end)
+    end
+    zones = {}
+end
+
+local function loadZones()
+    clearZones()
+    if GetResourceState('ox_target') ~= 'started' then return end
+    local points = lib.callback.await('qbx_policejob:server:fredpdArmories', false) or {}
+    for _, point in ipairs(points) do
+        local size = (tonumber(point.radius) or 1.5) * 2
+        local ok, id = pcall(function()
+            return exports.ox_target:addBoxZone({
+                coords = vec3(point.coords.x, point.coords.y, point.coords.z),
+                size = vec3(size, size, 3.0),
+                options = { {
+                    name = 'fredpd_armory_' .. point.id,
+                    label = locale('menu.pol_armory'),
+                    icon = 'fa-solid fa-gun',
+                    distance = 2.0,
+                    canInteract = canUse,
+                    onSelect = function() openArmory(point.id) end,
+                } },
+            })
+        end)
+        if ok and id then zones[#zones + 1] = id end
+    end
+end
+
+CreateThread(loadZones)
+
+AddEventHandler('onClientResourceStart', function(resource)
+    if resource == 'fredpd_core' or resource == 'ox_target' then CreateThread(loadZones) end
+end)
