# fredpd_service configuration. Copy to apps/service/.env (git-ignored) and fill in. docs/modules/service.md
# explains each value. No real secrets in this file: the CHANGE_ME values (database password included) and the
# all-zero Discord ids below are refused at start on purpose, as is a SESSION_SECRET equal to FREDPD_HMAC_SECRET.

# HTTP listener. Keep 127.0.0.1 behind Cloudflare Tunnel or Caddy on the same machine.
PORT=3000
HOST=127.0.0.1

# Same MariaDB as FXServer (oxmysql). mysql://user:password@host:port/database
FREDPD_DB_URL=mysql://fredpd:CHANGE_ME@127.0.0.1:3306/fredpd

# Shared with FXServer (server.cfg: set fredpd_hmac_secret "..."). At least 32 random characters, identical on both
# sides, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
FREDPD_HMAC_SECRET=CHANGE_ME_generate_64_hex_characters

# fredpd_core's HTTP handler lives on the game port.
FXSERVER_URL=http://127.0.0.1:30120

# Discord application (https://discord.com/developers/applications): OAuth2 client for the portal login and the bot
# token. Redirect URL to register in the application: <PUBLIC_URL>/auth/discord/callback. The bot needs the
# "Server Members Intent" and must be a member of the guild below.
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=CHANGE_ME
DISCORD_BOT_TOKEN=CHANGE_ME
DISCORD_GUILD_ID=000000000000000000

# Public HTTPS address of the portal/service (OAuth callback, avatar URLs shown in game, allowed WebSocket origin).
PUBLIC_URL=https://polis.example.se

# Signs the session cookie. At least 32 random characters, different from FREDPD_HMAC_SECRET.
SESSION_SECRET=CHANGE_ME_generate_another_64_hex_characters

# Uploaded images and the avatar cache (relative to apps/service; data/ is git-ignored).
UPLOAD_DIR=data/uploads

# The built portal (pnpm build writes apps/portal/dist); the service serves it at PUBLIC_URL.
PORTAL_DIR=../portal/dist

# Officer names: discord_nick (server nickname -> global name -> username), discord_global, or character.
OFFICER_NAME_SOURCE=discord_nick

# true behind HTTPS (production). false only for plain-http local development.
COOKIE_SECURE=true

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
